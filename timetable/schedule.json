{
  "meta": {
    "title": "1日の時刻表",
    "note": "blocks は start（開始時刻）だけを書きます。終了時刻は次のブロックの start です。最後のブロックは 24:00 で終わります。"
  },

  "lines": {
    "work":   { "label": "仕事",   "color": "#3557A6", "colorDark": "#6E92DC" },
    "gym":    { "label": "筋トレ", "color": "#17825C", "colorDark": "#3FBA8B" },
    "meal":   { "label": "食事",   "color": "#C96A21", "colorDark": "#E4954E" },
    "chores": { "label": "家事",   "color": "#7B5EA7", "colorDark": "#A98FD6" },
    "study":  { "label": "勉強",   "color": "#C0304F", "colorDark": "#E86A85" },
    "play":   { "label": "娯楽",   "color": "#1C7B95", "colorDark": "#4CAFC9" },
    "rest":   { "label": "休息",   "color": "#9AA4AF", "colorDark": "#6C7885" }
  },

  "studyThemes": {
    "mon": "PHP / WP内部 — テンプレート階層・WP_Query・フック",
    "tue": "JavaScript — 素のJSでDOM操作と fetch",
    "wed": "CSS — Grid / Flex / カスタムプロパティ / clamp()",
    "thu": "脱プラグイン化 — register_post_type() をコードで",
    "fri": "実装日 — 今週やったことを実案件に入れる",
    "sat": "積み残しと実装",
    "sun": "積み残しと実装"
  },

